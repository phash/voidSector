# voidSector environment configuration
# Copy to `.env` (gitignored) and fill in real values for production.
# docker-compose.yml falls back to dev defaults when these are unset.

# --- Database ---
POSTGRES_USER=voidsector
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=voidsector

# --- Secrets (MUST be changed for production) ---
# JWT signing secret for player auth tokens. Use a long random string.
JWT_SECRET=change-me-long-random-string
# Bearer token for the /admin API. Use a long random string.
ADMIN_TOKEN=change-me-long-random-string

# --- Cloudflare (production named tunnel) ---
# For a stable public URL, create a named tunnel and put its token here,
# then switch the cloudflared command in docker-compose.yml to `tunnel run`.
# CLOUDFLARE_TUNNEL_TOKEN=
